{
  "surah": {
    "id": 92,
    "name_arabic": "الليل",
    "name_english": "The Night",
    "revelation_place": "makkah",
    "verses_count": 21
  },
  "verses": [
    {
      "id": 6059,
      "verse_number": 1,
      "text_uthmani": " وَٱلَّيْلِ إِذَا يَغْشَىٰ",
      "translation": "By the enshrouding night,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/092001.mp3"
    },
    {
      "id": 6060,
      "verse_number": 2,
      "text_uthmani": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ",
      "translation": "by the radiant day,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/092002.mp3"
    },
    {
      "id": 6061,
      "verse_number": 3,
      "text_uthmani": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ",
      "translation": "by His creation of male and female!",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/092003.mp3"
    },
    {
      "id": 6062,
      "verse_number": 4,
      "text_uthmani": "إِنَّ سَعْيَكُمْ لَشَتَّىٰ",
      "translation": "The ways you take differ greatly.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/092004.mp3"
    },
    {
      "id": 6063,
      "verse_number": 5,
      "text_uthmani": "فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ",
      "translation": "There is the one who gives, who is mindful of God,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/092005.mp3"
    },
    {
      "id": 6064,
      "verse_number": 6,
      "text_uthmani": "وَصَدَّقَ بِٱلْحُسْنَىٰ",
      "translation": "who testifies to goodness––",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/092006.mp3"
    },
    {
      "id": 6065,
      "verse_number": 7,
      "text_uthmani": "فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ",
      "translation": "We shall smooth his way towards ease.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/092007.mp3"
    },
    {
      "id": 6066,
      "verse_number": 8,
      "text_uthmani": "وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ",
      "translation": "There is the one who is miserly, who is self-satisfied,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/092008.mp3"
    },
    {
      "id": 6067,
      "verse_number": 9,
      "text_uthmani": "وَكَذَّبَ بِٱلْحُسْنَىٰ",
      "translation": "who denies goodness––",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/092009.mp3"
    },
    {
      "id": 6068,
      "verse_number": 10,
      "text_uthmani": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ",
      "translation": "We shall smooth his way towards hardship",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/092010.mp3"
    },
    {
      "id": 6069,
      "verse_number": 11,
      "text_uthmani": "وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ",
      "translation": "and his wealth will not help him as he falls.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/092011.mp3"
    },
    {
      "id": 6070,
      "verse_number": 12,
      "text_uthmani": "إِنَّ عَلَيْنَا لَلْهُدَىٰ",
      "translation": "Our part is to provide guidance––",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/092012.mp3"
    },
    {
      "id": 6071,
      "verse_number": 13,
      "text_uthmani": "وَإِنَّ لَنَا لَلْـَٔاخِرَةَ وَٱلْأُولَىٰ",
      "translation": "this world and the next belong to Us––",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/092013.mp3"
    },
    {
      "id": 6072,
      "verse_number": 14,
      "text_uthmani": "فَأَنذَرْتُكُمْ نَارًا تَلَظَّىٰ",
      "translation": "so I warn you about the raging Fire,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/092014.mp3"
    },
    {
      "id": 6073,
      "verse_number": 15,
      "text_uthmani": "لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى",
      "translation": "in which none but the most wicked one will burn,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/092015.mp3"
    },
    {
      "id": 6074,
      "verse_number": 16,
      "text_uthmani": "ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ",
      "translation": "who denied [the truth], and turned away.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/092016.mp3"
    },
    {
      "id": 6075,
      "verse_number": 17,
      "text_uthmani": "وَسَيُجَنَّبُهَا ٱلْأَتْقَى",
      "translation": "The most pious one will be spared this––",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/092017.mp3"
    },
    {
      "id": 6076,
      "verse_number": 18,
      "text_uthmani": "ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ",
      "translation": "who gives his wealth away as self-purification,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/092018.mp3"
    },
    {
      "id": 6077,
      "verse_number": 19,
      "text_uthmani": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍ تُجْزَىٰٓ",
      "translation": "not to return a favour to anyone",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/092019.mp3"
    },
    {
      "id": 6078,
      "verse_number": 20,
      "text_uthmani": "إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ",
      "translation": "but for the sake of his Lord the Most High––",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/092020.mp3"
    },
    {
      "id": 6079,
      "verse_number": 21,
      "text_uthmani": "وَلَسَوْفَ يَرْضَىٰ",
      "translation": "and he will be well pleased.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/092021.mp3"
    }
  ]
}