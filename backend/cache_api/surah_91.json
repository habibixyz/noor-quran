{
  "surah": {
    "id": 91,
    "name_arabic": "الشمس",
    "name_english": "The Sun",
    "revelation_place": "makkah",
    "verses_count": 15
  },
  "verses": [
    {
      "id": 6044,
      "verse_number": 1,
      "text_uthmani": " وَٱلشَّمْسِ وَضُحَىٰهَا",
      "translation": "By the sun in its morning brightness",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/091001.mp3"
    },
    {
      "id": 6045,
      "verse_number": 2,
      "text_uthmani": "وَٱلْقَمَرِ إِذَا تَلَىٰهَا",
      "translation": "and by the moon as it follows it,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/091002.mp3"
    },
    {
      "id": 6046,
      "verse_number": 3,
      "text_uthmani": "وَٱلنَّهَارِ إِذَا جَلَّىٰهَا",
      "translation": "by the day as it displays the sun’s glory",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/091003.mp3"
    },
    {
      "id": 6047,
      "verse_number": 4,
      "text_uthmani": "وَٱلَّيْلِ إِذَا يَغْشَىٰهَا",
      "translation": "and by the night as it conceals it,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/091004.mp3"
    },
    {
      "id": 6048,
      "verse_number": 5,
      "text_uthmani": "وَٱلسَّمَآءِ وَمَا بَنَىٰهَا",
      "translation": "by the sky and how He built it",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/091005.mp3"
    },
    {
      "id": 6049,
      "verse_number": 6,
      "text_uthmani": "وَٱلْأَرْضِ وَمَا طَحَىٰهَا",
      "translation": "and by the earth and how He spread it,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/091006.mp3"
    },
    {
      "id": 6050,
      "verse_number": 7,
      "text_uthmani": "وَنَفْسٍ وَمَا سَوَّىٰهَا",
      "translation": "by the soul and how He formed it",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/091007.mp3"
    },
    {
      "id": 6051,
      "verse_number": 8,
      "text_uthmani": "فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا",
      "translation": "and inspired it [to know] its own rebellion and piety!",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/091008.mp3"
    },
    {
      "id": 6052,
      "verse_number": 9,
      "text_uthmani": "قَدْ أَفْلَحَ مَن زَكَّىٰهَا",
      "translation": "The one who purifies his soul succeeds",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/091009.mp3"
    },
    {
      "id": 6053,
      "verse_number": 10,
      "text_uthmani": "وَقَدْ خَابَ مَن دَسَّىٰهَا",
      "translation": "and the one who corrupts it fails.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/091010.mp3"
    },
    {
      "id": 6054,
      "verse_number": 11,
      "text_uthmani": "كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ",
      "translation": "In their arrogant cruelty, the people of Thamud called [their messenger] a liar,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/091011.mp3"
    },
    {
      "id": 6055,
      "verse_number": 12,
      "text_uthmani": "إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا",
      "translation": "when the most wicked man among them rose [against him].",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/091012.mp3"
    },
    {
      "id": 6056,
      "verse_number": 13,
      "text_uthmani": "فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَـٰهَا",
      "translation": "The messenger of God said to them, ‘[Leave] God’s camel to drink,’",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/091013.mp3"
    },
    {
      "id": 6057,
      "verse_number": 14,
      "text_uthmani": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا",
      "translation": "but they called him a liar and hamstrung her. Their Lord destroyed them for their crime and levelled them.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/091014.mp3"
    },
    {
      "id": 6058,
      "verse_number": 15,
      "text_uthmani": "وَلَا يَخَافُ عُقْبَـٰهَا",
      "translation": "He did not hesitate to punish them.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/091015.mp3"
    }
  ]
}