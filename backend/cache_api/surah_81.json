{
  "surah": {
    "id": 81,
    "name_arabic": "التكوير",
    "name_english": "The Overthrowing",
    "revelation_place": "makkah",
    "verses_count": 29
  },
  "verses": [
    {
      "id": 5801,
      "verse_number": 1,
      "text_uthmani": " إِذَا ٱلشَّمْسُ كُوِّرَتْ",
      "translation": "When the sun is shrouded in darkness,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/081001.mp3"
    },
    {
      "id": 5802,
      "verse_number": 2,
      "text_uthmani": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ",
      "translation": "when the stars are dimmed,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/081002.mp3"
    },
    {
      "id": 5803,
      "verse_number": 3,
      "text_uthmani": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ",
      "translation": "when the mountains are set in motion,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/081003.mp3"
    },
    {
      "id": 5804,
      "verse_number": 4,
      "text_uthmani": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ",
      "translation": "when pregnant camels are abandoned,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/081004.mp3"
    },
    {
      "id": 5805,
      "verse_number": 5,
      "text_uthmani": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ",
      "translation": "when wild beasts are herded together,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/081005.mp3"
    },
    {
      "id": 5806,
      "verse_number": 6,
      "text_uthmani": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ",
      "translation": "when the seas boil over,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/081006.mp3"
    },
    {
      "id": 5807,
      "verse_number": 7,
      "text_uthmani": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ",
      "translation": "when souls are sorted into classes,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/081007.mp3"
    },
    {
      "id": 5808,
      "verse_number": 8,
      "text_uthmani": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ",
      "translation": "when the baby girl buried alive is asked",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/081008.mp3"
    },
    {
      "id": 5809,
      "verse_number": 9,
      "text_uthmani": "بِأَىِّ ذَنۢبٍ قُتِلَتْ",
      "translation": "for what sin she was killed,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/081009.mp3"
    },
    {
      "id": 5810,
      "verse_number": 10,
      "text_uthmani": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ",
      "translation": "when the records of deeds are spread open,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/081010.mp3"
    },
    {
      "id": 5811,
      "verse_number": 11,
      "text_uthmani": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ",
      "translation": "when the sky is stripped away,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/081011.mp3"
    },
    {
      "id": 5812,
      "verse_number": 12,
      "text_uthmani": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ",
      "translation": "when Hell is made to blaze",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/081012.mp3"
    },
    {
      "id": 5813,
      "verse_number": 13,
      "text_uthmani": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ",
      "translation": "and Paradise brought near:",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/081013.mp3"
    },
    {
      "id": 5814,
      "verse_number": 14,
      "text_uthmani": "عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ",
      "translation": "then every soul will know what it has brought about.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/081014.mp3"
    },
    {
      "id": 5815,
      "verse_number": 15,
      "text_uthmani": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ",
      "translation": "I swear by the planets",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/081015.mp3"
    },
    {
      "id": 5816,
      "verse_number": 16,
      "text_uthmani": "ٱلْجَوَارِ ٱلْكُنَّسِ",
      "translation": "that recede, move, and hide,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/081016.mp3"
    },
    {
      "id": 5817,
      "verse_number": 17,
      "text_uthmani": "وَٱلَّيْلِ إِذَا عَسْعَسَ",
      "translation": "by the night that descends,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/081017.mp3"
    },
    {
      "id": 5818,
      "verse_number": 18,
      "text_uthmani": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ",
      "translation": "by the dawn that softly breathes:",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/081018.mp3"
    },
    {
      "id": 5819,
      "verse_number": 19,
      "text_uthmani": "إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ",
      "translation": "this is the speech of a noble messenger,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/081019.mp3"
    },
    {
      "id": 5820,
      "verse_number": 20,
      "text_uthmani": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ",
      "translation": "who possesses great strength and is held in honour by the Lord of the Throne––",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/081020.mp3"
    },
    {
      "id": 5821,
      "verse_number": 21,
      "text_uthmani": "مُّطَاعٍ ثَمَّ أَمِينٍ",
      "translation": "he is obeyed there and worthy of trust.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/081021.mp3"
    },
    {
      "id": 5822,
      "verse_number": 22,
      "text_uthmani": "وَمَا صَاحِبُكُم بِمَجْنُونٍ",
      "translation": "Your companion is not mad:",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/081022.mp3"
    },
    {
      "id": 5823,
      "verse_number": 23,
      "text_uthmani": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ",
      "translation": "he did see him on the clear horizon.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/081023.mp3"
    },
    {
      "id": 5824,
      "verse_number": 24,
      "text_uthmani": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ",
      "translation": "He does not withhold what is revealed to him from beyond.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/081024.mp3"
    },
    {
      "id": 5825,
      "verse_number": 25,
      "text_uthmani": "وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍ رَّجِيمٍ",
      "translation": "This is not the word of an outcast devil.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/081025.mp3"
    },
    {
      "id": 5826,
      "verse_number": 26,
      "text_uthmani": "فَأَيْنَ تَذْهَبُونَ",
      "translation": "So where are you [people] going?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/081026.mp3"
    },
    {
      "id": 5827,
      "verse_number": 27,
      "text_uthmani": "إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ",
      "translation": "This is a message for all people;",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/081027.mp3"
    },
    {
      "id": 5828,
      "verse_number": 28,
      "text_uthmani": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ",
      "translation": "for those who wish to take the straight path.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/081028.mp3"
    },
    {
      "id": 5829,
      "verse_number": 29,
      "text_uthmani": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ",
      "translation": "But you will only wish to do so by the will of God, the Lord of all people.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/081029.mp3"
    }
  ]
}