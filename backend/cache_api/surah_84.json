{
  "surah": {
    "id": 84,
    "name_arabic": "الإنشقاق",
    "name_english": "The Sundering",
    "revelation_place": "makkah",
    "verses_count": 25
  },
  "verses": [
    {
      "id": 5885,
      "verse_number": 1,
      "text_uthmani": " إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ",
      "translation": "When the sky is ripped apart,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/084001.mp3"
    },
    {
      "id": 5886,
      "verse_number": 2,
      "text_uthmani": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ",
      "translation": "obeying its Lord as it rightly must,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/084002.mp3"
    },
    {
      "id": 5887,
      "verse_number": 3,
      "text_uthmani": "وَإِذَا ٱلْأَرْضُ مُدَّتْ",
      "translation": "when the earth is levelled out,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/084003.mp3"
    },
    {
      "id": 5888,
      "verse_number": 4,
      "text_uthmani": "وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ",
      "translation": "casts out its contents, and becomes empty,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/084004.mp3"
    },
    {
      "id": 5889,
      "verse_number": 5,
      "text_uthmani": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ",
      "translation": "obeying its Lord as it rightly must,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/084005.mp3"
    },
    {
      "id": 5890,
      "verse_number": 6,
      "text_uthmani": "يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًا فَمُلَـٰقِيهِ",
      "translation": "you humans, toiling laboriously towards your Lord, will meet Him:",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/084006.mp3"
    },
    {
      "id": 5891,
      "verse_number": 7,
      "text_uthmani": "فَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ بِيَمِينِهِۦ",
      "translation": "whoever is given his record in his right hand",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/084007.mp3"
    },
    {
      "id": 5892,
      "verse_number": 8,
      "text_uthmani": "فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا",
      "translation": "will have an easy reckoning",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/084008.mp3"
    },
    {
      "id": 5893,
      "verse_number": 9,
      "text_uthmani": "وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًا",
      "translation": "and return to his people well pleased,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/084009.mp3"
    },
    {
      "id": 5894,
      "verse_number": 10,
      "text_uthmani": "وَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ وَرَآءَ ظَهْرِهِۦ",
      "translation": "but whoever is given his record from behind his back",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/084010.mp3"
    },
    {
      "id": 5895,
      "verse_number": 11,
      "text_uthmani": "فَسَوْفَ يَدْعُوا۟ ثُبُورًا",
      "translation": "will cry out for destruction––",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/084011.mp3"
    },
    {
      "id": 5896,
      "verse_number": 12,
      "text_uthmani": "وَيَصْلَىٰ سَعِيرًا",
      "translation": "he will burn in the blazing Fire.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/084012.mp3"
    },
    {
      "id": 5897,
      "verse_number": 13,
      "text_uthmani": "إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا",
      "translation": "He used to live among his people well pleased.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/084013.mp3"
    },
    {
      "id": 5898,
      "verse_number": 14,
      "text_uthmani": "إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ",
      "translation": "He thought he would never return [to his Lord]––",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/084014.mp3"
    },
    {
      "id": 5899,
      "verse_number": 15,
      "text_uthmani": "بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًا",
      "translation": "indeed he will! His Lord was watching him.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/084015.mp3"
    },
    {
      "id": 5900,
      "verse_number": 16,
      "text_uthmani": "فَلَآ أُقْسِمُ بِٱلشَّفَقِ",
      "translation": "I swear by the glow of sunset,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/084016.mp3"
    },
    {
      "id": 5901,
      "verse_number": 17,
      "text_uthmani": "وَٱلَّيْلِ وَمَا وَسَقَ",
      "translation": "by the night and what it covers,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/084017.mp3"
    },
    {
      "id": 5902,
      "verse_number": 18,
      "text_uthmani": "وَٱلْقَمَرِ إِذَا ٱتَّسَقَ",
      "translation": "by the full moon,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/084018.mp3"
    },
    {
      "id": 5903,
      "verse_number": 19,
      "text_uthmani": "لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍ",
      "translation": "you will progress from stage to stage.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/084019.mp3"
    },
    {
      "id": 5904,
      "verse_number": 20,
      "text_uthmani": "فَمَا لَهُمْ لَا يُؤْمِنُونَ",
      "translation": "So why do they not believe?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/084020.mp3"
    },
    {
      "id": 5905,
      "verse_number": 21,
      "text_uthmani": "وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ ۩",
      "translation": "Why, when the Quran is read to them, do they not prostrate themselves [to God]?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/084021.mp3"
    },
    {
      "id": 5906,
      "verse_number": 22,
      "text_uthmani": "بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ",
      "translation": "No! The disbelievers reject the Quran––",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/084022.mp3"
    },
    {
      "id": 5907,
      "verse_number": 23,
      "text_uthmani": "وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ",
      "translation": "God knows best what they keep hidden inside––",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/084023.mp3"
    },
    {
      "id": 5908,
      "verse_number": 24,
      "text_uthmani": "فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ",
      "translation": "so give them news of a painful torment.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/084024.mp3"
    },
    {
      "id": 5909,
      "verse_number": 25,
      "text_uthmani": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ",
      "translation": "But those who believe and do good deeds will have a never-ending reward.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/084025.mp3"
    }
  ]
}