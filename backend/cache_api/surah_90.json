{
  "surah": {
    "id": 90,
    "name_arabic": "البلد",
    "name_english": "The City",
    "revelation_place": "makkah",
    "verses_count": 20
  },
  "verses": [
    {
      "id": 6024,
      "verse_number": 1,
      "text_uthmani": " لَآ أُقْسِمُ بِهَـٰذَا ٱلْبَلَدِ",
      "translation": "I swear by this city––",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/090001.mp3"
    },
    {
      "id": 6025,
      "verse_number": 2,
      "text_uthmani": "وَأَنتَ حِلٌّۢ بِهَـٰذَا ٱلْبَلَدِ",
      "translation": "and you [Prophet] are an inhabitant of this city––",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/090002.mp3"
    },
    {
      "id": 6026,
      "verse_number": 3,
      "text_uthmani": "وَوَالِدٍ وَمَا وَلَدَ",
      "translation": "[I swear] by parent and offspring,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/090003.mp3"
    },
    {
      "id": 6027,
      "verse_number": 4,
      "text_uthmani": "لَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ فِى كَبَدٍ",
      "translation": "that We have created man for toil and trial.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/090004.mp3"
    },
    {
      "id": 6028,
      "verse_number": 5,
      "text_uthmani": "أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌ",
      "translation": "Does he think that no one will have power over him?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/090005.mp3"
    },
    {
      "id": 6029,
      "verse_number": 6,
      "text_uthmani": "يَقُولُ أَهْلَكْتُ مَالًا لُّبَدًا",
      "translation": "‘I have squandered great wealth,’ he says.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/090006.mp3"
    },
    {
      "id": 6030,
      "verse_number": 7,
      "text_uthmani": "أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ",
      "translation": "Does he think no one observes him?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/090007.mp3"
    },
    {
      "id": 6031,
      "verse_number": 8,
      "text_uthmani": "أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ",
      "translation": "Did We not give him eyes,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/090008.mp3"
    },
    {
      "id": 6032,
      "verse_number": 9,
      "text_uthmani": "وَلِسَانًا وَشَفَتَيْنِ",
      "translation": "a tongue, lips,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/090009.mp3"
    },
    {
      "id": 6033,
      "verse_number": 10,
      "text_uthmani": "وَهَدَيْنَـٰهُ ٱلنَّجْدَيْنِ",
      "translation": "and point out to him the two clear ways [of good and evil]?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/090010.mp3"
    },
    {
      "id": 6034,
      "verse_number": 11,
      "text_uthmani": "فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ",
      "translation": "Yet he has not attempted the steep path.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/090011.mp3"
    },
    {
      "id": 6035,
      "verse_number": 12,
      "text_uthmani": "وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ",
      "translation": "What will explain to you what the steep path is?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/090012.mp3"
    },
    {
      "id": 6036,
      "verse_number": 13,
      "text_uthmani": "فَكُّ رَقَبَةٍ",
      "translation": "It is to free a slave,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/090013.mp3"
    },
    {
      "id": 6037,
      "verse_number": 14,
      "text_uthmani": "أَوْ إِطْعَـٰمٌ فِى يَوْمٍ ذِى مَسْغَبَةٍ",
      "translation": "to feed at a time of hunger",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/090014.mp3"
    },
    {
      "id": 6038,
      "verse_number": 15,
      "text_uthmani": "يَتِيمًا ذَا مَقْرَبَةٍ",
      "translation": "an orphaned relative",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/090015.mp3"
    },
    {
      "id": 6039,
      "verse_number": 16,
      "text_uthmani": "أَوْ مِسْكِينًا ذَا مَتْرَبَةٍ",
      "translation": "or a poor person in distress,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/090016.mp3"
    },
    {
      "id": 6040,
      "verse_number": 17,
      "text_uthmani": "ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ",
      "translation": "and to be one of those who believe and urge one another to steadfastness and compassion.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/090017.mp3"
    },
    {
      "id": 6041,
      "verse_number": 18,
      "text_uthmani": "أُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلْمَيْمَنَةِ",
      "translation": "Those who do this will be on the right-hand side,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/090018.mp3"
    },
    {
      "id": 6042,
      "verse_number": 19,
      "text_uthmani": "وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَـٰتِنَا هُمْ أَصْحَـٰبُ ٱلْمَشْـَٔمَةِ",
      "translation": "but those who disbelieve in Our revelations will be on the left-hand side,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/090019.mp3"
    },
    {
      "id": 6043,
      "verse_number": 20,
      "text_uthmani": "عَلَيْهِمْ نَارٌ مُّؤْصَدَةٌۢ",
      "translation": "and the Fire will close in on them.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/090020.mp3"
    }
  ]
}