    },
    {
      "id": 6100,
      "verse_number": 2,
      "text_uthmani": "وَطُورِ سِينِينَ",
      "translation": "by Mount Sinai,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/095002.mp3"
    },
    {
      "id": 6101,
      "verse_number": 3,
      "text_uthmani": "وَهَـٰذَا ٱلْبَلَدِ ٱلْأَمِينِ",
      "translation": "by this safe town,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/095003.mp3"
    },
    {
      "id": 6102,
      "verse_number": 4,
      "text_uthmani": "لَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍ",
      "translation": "We create man in the finest state",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/095004.mp3"
    },
    {
      "id": 6103,
      "verse_number": 5,
      "text_uthmani": "ثُمَّ رَدَدْنَـٰهُ أَسْفَلَ سَـٰفِلِينَ",
      "translation": "then reduce him to the lowest of the low,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/095005.mp3"
    },
    {
      "id": 6104,
      "verse_number": 6,
      "text_uthmani": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ",
      "translation": "except those who believe and do good deeds–– they will have an unfailing reward.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/095006.mp3"
    },
    {
      "id": 6105,
      "verse_number": 7,
      "text_uthmani": "فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ",
      "translation": "After this, what makes you [man] deny the Judgement?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/095007.mp3"
    },
    {
      "id": 6106,
      "verse_number": 8,
      "text_uthmani": "أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَـٰكِمِينَ",
      "translation": "Is God not the most decisive of judges?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/095008.mp3"
    }
  ]
