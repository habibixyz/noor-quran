{
  "surah": {
    "id": 96,
    "name_arabic": "العلق",
    "name_english": "The Clot",
    "revelation_place": "makkah",
    "verses_count": 19
  },
  "verses": [
    {
      "id": 6107,
      "verse_number": 1,
      "text_uthmani": " ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ",
      "translation": "Read! In the name of your Lord who created:",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/096001.mp3"
    },
    {
      "id": 6108,
      "verse_number": 2,
      "text_uthmani": "خَلَقَ ٱلْإِنسَـٰنَ مِنْ عَلَقٍ",
      "translation": "He created manfrom a clinging form.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/096002.mp3"
    },
    {
      "id": 6109,
      "verse_number": 3,
      "text_uthmani": "ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ",
      "translation": "Read! Your Lord is the Most Bountiful One",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/096003.mp3"
    },
    {
      "id": 6110,
      "verse_number": 4,
      "text_uthmani": "ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ",
      "translation": "who taught by [means of] the pen,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/096004.mp3"
    },
    {
      "id": 6111,
      "verse_number": 5,
      "text_uthmani": "عَلَّمَ ٱلْإِنسَـٰنَ مَا لَمْ يَعْلَمْ",
      "translation": "who taught man what he did not know.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/096005.mp3"
    },
    {
      "id": 6112,
      "verse_number": 6,
      "text_uthmani": "كَلَّآ إِنَّ ٱلْإِنسَـٰنَ لَيَطْغَىٰٓ",
      "translation": "But man exceeds all bounds",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/096006.mp3"
    },
    {
      "id": 6113,
      "verse_number": 7,
      "text_uthmani": "أَن رَّءَاهُ ٱسْتَغْنَىٰٓ",
      "translation": "when he thinks he is self-sufficient:",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/096007.mp3"
    },
    {
      "id": 6114,
      "verse_number": 8,
      "text_uthmani": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ",
      "translation": "[Prophet], all will return to your Lord.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/096008.mp3"
    },
    {
      "id": 6115,
      "verse_number": 9,
      "text_uthmani": "أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ",
      "translation": "Have you seen the man who forbids",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/096009.mp3"
    },
    {
      "id": 6116,
      "verse_number": 10,
      "text_uthmani": "عَبْدًا إِذَا صَلَّىٰٓ",
      "translation": "[Our] servant to pray?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/096010.mp3"
    },
    {
      "id": 6117,
      "verse_number": 11,
      "text_uthmani": "أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ",
      "translation": "Have you seen whether he is rightly guided,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/096011.mp3"
    },
    {
      "id": 6118,
      "verse_number": 12,
      "text_uthmani": "أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ",
      "translation": "or encourages true piety?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/096012.mp3"
    },
    {
      "id": 6119,
      "verse_number": 13,
      "text_uthmani": "أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ",
      "translation": "Have you seen whether he denies the truth and turns away from it?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/096013.mp3"
    },
    {
      "id": 6120,
      "verse_number": 14,
      "text_uthmani": "أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ",
      "translation": "Does he not realize that God sees all?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/096014.mp3"
    },
    {
      "id": 6121,
      "verse_number": 15,
      "text_uthmani": "كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ",
      "translation": "No! If he does not stop, We shall drag him by his forehead––",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/096015.mp3"
    },
    {
      "id": 6122,
      "verse_number": 16,
      "text_uthmani": "نَاصِيَةٍ كَـٰذِبَةٍ خَاطِئَةٍ",
      "translation": "his lying, sinful forehead.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/096016.mp3"
    },
    {
      "id": 6123,
      "verse_number": 17,
      "text_uthmani": "فَلْيَدْعُ نَادِيَهُۥ",
      "translation": "Let him summon his comrades;",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/096017.mp3"
    },
    {
      "id": 6124,
      "verse_number": 18,
      "text_uthmani": "سَنَدْعُ ٱلزَّبَانِيَةَ",
      "translation": "We shall summon the guards of Hell.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/096018.mp3"
    },
    {
      "id": 6125,
      "verse_number": 19,
      "text_uthmani": "كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩",
      "translation": "No! Do not obey him [Prophet]: bow down in worship and draw close.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/096019.mp3"
    }
  ]
}