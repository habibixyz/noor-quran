{
  "surah": {
    "id": 86,
    "name_arabic": "الطارق",
    "name_english": "The Nightcommer",
    "revelation_place": "makkah",
    "verses_count": 17
  },
  "verses": [
    {
      "id": 5932,
      "verse_number": 1,
      "text_uthmani": " وَٱلسَّمَآءِ وَٱلطَّارِقِ",
      "translation": "By the sky and the night-comer––",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/086001.mp3"
    },
    {
      "id": 5933,
      "verse_number": 2,
      "text_uthmani": "وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ",
      "translation": "What will explain to you what the night-comer is?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/086002.mp3"
    },
    {
      "id": 5934,
      "verse_number": 3,
      "text_uthmani": "ٱلنَّجْمُ ٱلثَّاقِبُ",
      "translation": "The piercing star––",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/086003.mp3"
    },
    {
      "id": 5935,
      "verse_number": 4,
      "text_uthmani": "إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ",
      "translation": "there is a watcher over every soul.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/086004.mp3"
    },
    {
      "id": 5936,
      "verse_number": 5,
      "text_uthmani": "فَلْيَنظُرِ ٱلْإِنسَـٰنُ مِمَّ خُلِقَ",
      "translation": "Man should reflect on what he was created from.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/086005.mp3"
    },
    {
      "id": 5937,
      "verse_number": 6,
      "text_uthmani": "خُلِقَ مِن مَّآءٍ دَافِقٍ",
      "translation": "He is created from spurting fluid,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/086006.mp3"
    },
    {
      "id": 5938,
      "verse_number": 7,
      "text_uthmani": "يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ",
      "translation": "then he emerges from between the backbone and breastbone:",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/086007.mp3"
    },
    {
      "id": 5939,
      "verse_number": 8,
      "text_uthmani": "إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌ",
      "translation": "God is certainly able to bring him back to life.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/086008.mp3"
    },
    {
      "id": 5940,
      "verse_number": 9,
      "text_uthmani": "يَوْمَ تُبْلَى ٱلسَّرَآئِرُ",
      "translation": "On the Day when secrets are laid bare",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/086009.mp3"
    },
    {
      "id": 5941,
      "verse_number": 10,
      "text_uthmani": "فَمَا لَهُۥ مِن قُوَّةٍ وَلَا نَاصِرٍ",
      "translation": "he will have no power and no one to help him.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/086010.mp3"
    },
    {
      "id": 5942,
      "verse_number": 11,
      "text_uthmani": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ",
      "translation": "By the sky and its recurring rain,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/086011.mp3"
    },
    {
      "id": 5943,
      "verse_number": 12,
      "text_uthmani": "وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ",
      "translation": "by the earth that cracks open!",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/086012.mp3"
    },
    {
      "id": 5944,
      "verse_number": 13,
      "text_uthmani": "إِنَّهُۥ لَقَوْلٌ فَصْلٌ",
      "translation": "This is truly a decisive statement;",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/086013.mp3"
    },
    {
      "id": 5945,
      "verse_number": 14,
      "text_uthmani": "وَمَا هُوَ بِٱلْهَزْلِ",
      "translation": "it is not something to be taken lightly.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/086014.mp3"
    },
    {
      "id": 5946,
      "verse_number": 15,
      "text_uthmani": "إِنَّهُمْ يَكِيدُونَ كَيْدًا",
      "translation": "They plot and scheme,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/086015.mp3"
    },
    {
      "id": 5947,
      "verse_number": 16,
      "text_uthmani": "وَأَكِيدُ كَيْدًا",
      "translation": "but so do I:",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/086016.mp3"
    },
    {
      "id": 5948,
      "verse_number": 17,
      "text_uthmani": "فَمَهِّلِ ٱلْكَـٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا",
      "translation": "[Prophet], let the disbelievers be, let them be for a while.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/086017.mp3"
    }
  ]
}