{
  "surah": {
    "id": 89,
    "name_arabic": "الفجر",
    "name_english": "The Dawn",
    "revelation_place": "makkah",
    "verses_count": 30
  },
  "verses": [
    {
      "id": 5994,
      "verse_number": 1,
      "text_uthmani": " وَٱلْفَجْرِ",
      "translation": "By the Daybreak,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/089001.mp3"
    },
    {
      "id": 5995,
      "verse_number": 2,
      "text_uthmani": "وَلَيَالٍ عَشْرٍ",
      "translation": "by the Ten Nights,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/089002.mp3"
    },
    {
      "id": 5996,
      "verse_number": 3,
      "text_uthmani": "وَٱلشَّفْعِ وَٱلْوَتْرِ",
      "translation": "by the even and the odd,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/089003.mp3"
    },
    {
      "id": 5997,
      "verse_number": 4,
      "text_uthmani": "وَٱلَّيْلِ إِذَا يَسْرِ",
      "translation": "by the passing night––",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/089004.mp3"
    },
    {
      "id": 5998,
      "verse_number": 5,
      "text_uthmani": "هَلْ فِى ذَٰلِكَ قَسَمٌ لِّذِى حِجْرٍ",
      "translation": "is this oath strong enough for a rational person?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/089005.mp3"
    },
    {
      "id": 5999,
      "verse_number": 6,
      "text_uthmani": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ",
      "translation": "Have you [Prophet] considered how your Lord dealt with [the people] of 'Ad,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/089006.mp3"
    },
    {
      "id": 6000,
      "verse_number": 7,
      "text_uthmani": "إِرَمَ ذَاتِ ٱلْعِمَادِ",
      "translation": "of Iram, [the city] of lofty pillars,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/089007.mp3"
    },
    {
      "id": 6001,
      "verse_number": 8,
      "text_uthmani": "ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَـٰدِ",
      "translation": "whose like has never been made in any land,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/089008.mp3"
    },
    {
      "id": 6002,
      "verse_number": 9,
      "text_uthmani": "وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ",
      "translation": "and the Thamud, who hewed into the rocks in the valley,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/089009.mp3"
    },
    {
      "id": 6003,
      "verse_number": 10,
      "text_uthmani": "وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ",
      "translation": "and the mighty and powerful Pharaoh?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/089010.mp3"
    },
    {
      "id": 6004,
      "verse_number": 11,
      "text_uthmani": "ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَـٰدِ",
      "translation": "All of them committed excesses in their lands,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/089011.mp3"
    },
    {
      "id": 6005,
      "verse_number": 12,
      "text_uthmani": "فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ",
      "translation": "and spread corruption there:",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/089012.mp3"
    },
    {
      "id": 6006,
      "verse_number": 13,
      "text_uthmani": "فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ",
      "translation": "your Lord let a scourge of punishment loose on them.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/089013.mp3"
    },
    {
      "id": 6007,
      "verse_number": 14,
      "text_uthmani": "إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ",
      "translation": "Your Lord is always watchful.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/089014.mp3"
    },
    {
      "id": 6008,
      "verse_number": 15,
      "text_uthmani": "فَأَمَّا ٱلْإِنسَـٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ",
      "translation": "[The nature of] man is that, when his Lord tries him through honour and blessings, he says, ‘My Lord has honoured me,’",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/089015.mp3"
    },
    {
      "id": 6009,
      "verse_number": 16,
      "text_uthmani": "وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَـٰنَنِ",
      "translation": "but when He tries him through the restriction of his provision, he says, ‘My Lord has humiliated me.’",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/089016.mp3"
    },
    {
      "id": 6010,
      "verse_number": 17,
      "text_uthmani": "كَلَّا ۖ بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ",
      "translation": "No indeed! You [people] do not honour orphans,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/089017.mp3"
    },
    {
      "id": 6011,
      "verse_number": 18,
      "text_uthmani": "وَلَا تَحَـٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ",
      "translation": "you do not urge one another to feed the poor,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/089018.mp3"
    },
    {
      "id": 6012,
      "verse_number": 19,
      "text_uthmani": "وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًا لَّمًّا",
      "translation": "you consume inheritance greedily,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/089019.mp3"
    },
    {
      "id": 6013,
      "verse_number": 20,
      "text_uthmani": "وَتُحِبُّونَ ٱلْمَالَ حُبًّا جَمًّا",
      "translation": "and you love wealth with a passion.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/089020.mp3"
    },
    {
      "id": 6014,
      "verse_number": 21,
      "text_uthmani": "كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّا دَكًّا",
      "translation": "No indeed! When the earth is pounded to dust, pounded and pounded,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/089021.mp3"
    },
    {
      "id": 6015,
      "verse_number": 22,
      "text_uthmani": "وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّا صَفًّا",
      "translation": "when your Lord comes with the angels, rank upon rank,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/089022.mp3"
    },
    {
      "id": 6016,
      "verse_number": 23,
      "text_uthmani": "وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ ۚ يَوْمَئِذٍ يَتَذَكَّرُ ٱلْإِنسَـٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ",
      "translation": "when Hell is that Day brought near- on that Day man will take heed, but what good will that be to him then?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/089023.mp3"
    },
    {
      "id": 6017,
      "verse_number": 24,
      "text_uthmani": "يَقُولُ يَـٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى",
      "translation": "He will say, ‘Would that I had provided for this life to come!’",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/089024.mp3"
    },
    {
      "id": 6018,
      "verse_number": 25,
      "text_uthmani": "فَيَوْمَئِذٍ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌ",
      "translation": "On that Day, no one will punish as He punishes,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/089025.mp3"
    },
    {
      "id": 6019,
      "verse_number": 26,
      "text_uthmani": "وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌ",
      "translation": "and no one will bind as He binds.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/089026.mp3"
    },
    {
      "id": 6020,
      "verse_number": 27,
      "text_uthmani": "يَـٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ",
      "translation": "‘[But] you, soul at peace:",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/089027.mp3"
    },
    {
      "id": 6021,
      "verse_number": 28,
      "text_uthmani": "ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةً مَّرْضِيَّةً",
      "translation": "return to your Lord well pleased and well pleasing;",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/089028.mp3"
    },
    {
      "id": 6022,
      "verse_number": 29,
      "text_uthmani": "فَٱدْخُلِى فِى عِبَـٰدِى",
      "translation": "go in among My servants;",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/089029.mp3"
    },
    {
      "id": 6023,
      "verse_number": 30,
      "text_uthmani": "وَٱدْخُلِى جَنَّتِى",
      "translation": "and into My Garden.’",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/089030.mp3"
    }
  ]
}