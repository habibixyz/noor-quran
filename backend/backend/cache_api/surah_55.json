    {
      "id": 4954,
      "verse_number": 53,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translation": "Which, then, of your Lord’s blessings do you both deny?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055053.mp3"
    },
    {
      "id": 4955,
      "verse_number": 54,
      "text_uthmani": "مُتَّكِـِٔينَ عَلَىٰ فُرُشٍۭ بَطَآئِنُهَا مِنْ إِسْتَبْرَقٍ ۚ وَجَنَى ٱلْجَنَّتَيْنِ دَانٍ",
