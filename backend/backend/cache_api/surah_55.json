{
  "surah": {
    "id": 55,
    "name_arabic": "الرحمن",
    "name_english": "The Beneficent",
    "revelation_place": "madinah",
    "verses_count": 78
  },
  "verses": [
    {
      "id": 4902,
      "verse_number": 1,
      "text_uthmani": " ٱلرَّحْمَـٰنُ",
      "translation": "It is the Lord of Mercy",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055001.mp3"
    },
    {
      "id": 4903,
      "verse_number": 2,
      "text_uthmani": "عَلَّمَ ٱلْقُرْءَانَ",
      "translation": "who taught the Quran.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055002.mp3"
    },
    {
      "id": 4904,
      "verse_number": 3,
      "text_uthmani": "خَلَقَ ٱلْإِنسَـٰنَ",
      "translation": "He created man",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055003.mp3"
    },
    {
      "id": 4905,
      "verse_number": 4,
      "text_uthmani": "عَلَّمَهُ ٱلْبَيَانَ",
      "translation": "and taught him to communicate.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055004.mp3"
    },
    {
      "id": 4906,
      "verse_number": 5,
      "text_uthmani": "ٱلشَّمْسُ وَٱلْقَمَرُ بِحُسْبَانٍ",
      "translation": "The sun and the moon follow their calculated courses;",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055005.mp3"
    },
    {
      "id": 4907,
      "verse_number": 6,
      "text_uthmani": "وَٱلنَّجْمُ وَٱلشَّجَرُ يَسْجُدَانِ",
      "translation": "the plants and the trees submit to His designs;",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055006.mp3"
    },
    {
      "id": 4908,
      "verse_number": 7,
      "text_uthmani": "وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلْمِيزَانَ",
      "translation": "He has raised up the sky. He has set the balance",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055007.mp3"
    },
    {
      "id": 4909,
      "verse_number": 8,
      "text_uthmani": "أَلَّا تَطْغَوْا۟ فِى ٱلْمِيزَانِ",
      "translation": "so that you may not exceed in the balance:",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055008.mp3"
    },
    {
      "id": 4910,
      "verse_number": 9,
      "text_uthmani": "وَأَقِيمُوا۟ ٱلْوَزْنَ بِٱلْقِسْطِ وَلَا تُخْسِرُوا۟ ٱلْمِيزَانَ",
      "translation": "weigh with justice and do not fall short in the balance.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055009.mp3"
    },
    {
      "id": 4911,
      "verse_number": 10,
      "text_uthmani": "وَٱلْأَرْضَ وَضَعَهَا لِلْأَنَامِ",
      "translation": "He set down the Earth for His creatures,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055010.mp3"
    },
    {
      "id": 4912,
      "verse_number": 11,
      "text_uthmani": "فِيهَا فَـٰكِهَةٌ وَٱلنَّخْلُ ذَاتُ ٱلْأَكْمَامِ",
      "translation": "with its fruits, its palm trees with sheathed clusters,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055011.mp3"
    },
    {
      "id": 4913,
      "verse_number": 12,
      "text_uthmani": "وَٱلْحَبُّ ذُو ٱلْعَصْفِ وَٱلرَّيْحَانُ",
      "translation": "its husked grain, its fragrant plants.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055012.mp3"
    },
    {
      "id": 4914,
      "verse_number": 13,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translation": "Which, then, of your Lord’s blessings do you both deny?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055013.mp3"
    },
    {
      "id": 4915,
      "verse_number": 14,
      "text_uthmani": "خَلَقَ ٱلْإِنسَـٰنَ مِن صَلْصَـٰلٍ كَٱلْفَخَّارِ",
      "translation": "He created mankind out of dried clay, like pottery,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055014.mp3"
    },
    {
      "id": 4916,
      "verse_number": 15,
      "text_uthmani": "وَخَلَقَ ٱلْجَآنَّ مِن مَّارِجٍ مِّن نَّارٍ",
      "translation": "the jinn out of smokeless fire.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055015.mp3"
    },
    {
      "id": 4917,
      "verse_number": 16,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translation": "Which, then, of your Lord’s blessings do you both deny?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055016.mp3"
    },
    {
      "id": 4918,
      "verse_number": 17,
      "text_uthmani": "رَبُّ ٱلْمَشْرِقَيْنِ وَرَبُّ ٱلْمَغْرِبَيْنِ",
      "translation": "He is Lord of the two risings and Lord of the two settings.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055017.mp3"
    },
    {
      "id": 4919,
      "verse_number": 18,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translation": "Which, then, of your Lord’s blessings do you both deny?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055018.mp3"
    },
    {
      "id": 4920,
      "verse_number": 19,
      "text_uthmani": "مَرَجَ ٱلْبَحْرَيْنِ يَلْتَقِيَانِ",
      "translation": "He released the two bodies of [fresh and salt] water. They meet,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055019.mp3"
    },
    {
      "id": 4921,
      "verse_number": 20,
      "text_uthmani": "بَيْنَهُمَا بَرْزَخٌ لَّا يَبْغِيَانِ",
      "translation": "yet there is a barrier between them they do not cross.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055020.mp3"
    },
    {
      "id": 4922,
      "verse_number": 21,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translation": "Which, then, of your Lord’s blessings do you both deny?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055021.mp3"
    },
    {
      "id": 4923,
      "verse_number": 22,
      "text_uthmani": "يَخْرُجُ مِنْهُمَا ٱللُّؤْلُؤُ وَٱلْمَرْجَانُ",
      "translation": "Pearls come forth from them: large ones, and small, brilliant ones.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055022.mp3"
    },
    {
      "id": 4924,
      "verse_number": 23,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translation": "Which, then, of your Lord’s blessings do you both deny?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055023.mp3"
    },
    {
      "id": 4925,
      "verse_number": 24,
      "text_uthmani": "وَلَهُ ٱلْجَوَارِ ٱلْمُنشَـَٔاتُ فِى ٱلْبَحْرِ كَٱلْأَعْلَـٰمِ",
      "translation": "His are the moving ships that float, high as mountains, on the sea.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055024.mp3"
    },
    {
      "id": 4926,
      "verse_number": 25,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translation": "Which, then, of your Lord’s blessings do you both deny?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055025.mp3"
    },
    {
      "id": 4927,
      "verse_number": 26,
      "text_uthmani": "كُلُّ مَنْ عَلَيْهَا فَانٍ",
      "translation": "Everyone on earth perishes;",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055026.mp3"
    },
    {
      "id": 4928,
      "verse_number": 27,
      "text_uthmani": "وَيَبْقَىٰ وَجْهُ رَبِّكَ ذُو ٱلْجَلَـٰلِ وَٱلْإِكْرَامِ",
      "translation": "all that remains is the Face of your Lord, full of majesty, bestowing honour.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055027.mp3"
    },
    {
      "id": 4929,
      "verse_number": 28,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translation": "Which, then, of your Lord’s blessings do you both deny?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055028.mp3"
    },
    {
      "id": 4930,
      "verse_number": 29,
      "text_uthmani": "يَسْـَٔلُهُۥ مَن فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ كُلَّ يَوْمٍ هُوَ فِى شَأْنٍ",
      "translation": "Everyone in heaven and earth entreats Him; every day He is at work.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055029.mp3"
    },
    {
      "id": 4931,
      "verse_number": 30,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translation": "Which, then, of your Lord’s blessings do you both deny?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055030.mp3"
    },
    {
      "id": 4932,
      "verse_number": 31,
      "text_uthmani": "سَنَفْرُغُ لَكُمْ أَيُّهَ ٱلثَّقَلَانِ",
      "translation": "We shall attend to you two huge armies [of jinn and mankind].",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055031.mp3"
    },
    {
      "id": 4933,
      "verse_number": 32,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translation": "Which, then, of your Lord’s blessings do you both deny?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055032.mp3"
    },
    {
      "id": 4934,
      "verse_number": 33,
      "text_uthmani": "يَـٰمَعْشَرَ ٱلْجِنِّ وَٱلْإِنسِ إِنِ ٱسْتَطَعْتُمْ أَن تَنفُذُوا۟ مِنْ أَقْطَارِ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ فَٱنفُذُوا۟ ۚ لَا تَنفُذُونَ إِلَّا بِسُلْطَـٰنٍ",
      "translation": "Jinn and mankind, if you can pass beyond the regions of heaven and earth, then do so: you will not pass without Our authority.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055033.mp3"
    },
    {
      "id": 4935,
      "verse_number": 34,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translation": "Which, then, of your Lord’s blessings do you both deny?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055034.mp3"
    },
    {
      "id": 4936,
      "verse_number": 35,
      "text_uthmani": "يُرْسَلُ عَلَيْكُمَا شُوَاظٌ مِّن نَّارٍ وَنُحَاسٌ فَلَا تَنتَصِرَانِ",
      "translation": "A flash of fire and smoke will be released upon you and no one will come to your aid.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055035.mp3"
    },
    {
      "id": 4937,
      "verse_number": 36,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translation": "Which, then, of your Lord’s blessings do you both deny?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055036.mp3"
    },
    {
      "id": 4938,
      "verse_number": 37,
      "text_uthmani": "فَإِذَا ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتْ وَرْدَةً كَٱلدِّهَانِ",
      "translation": "When the sky is torn apart and turns crimson, like red hide.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055037.mp3"
    },
    {
      "id": 4939,
      "verse_number": 38,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translation": "Which, then, of your Lord’s blessings do you both deny?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055038.mp3"
    },
    {
      "id": 4940,
      "verse_number": 39,
      "text_uthmani": "فَيَوْمَئِذٍ لَّا يُسْـَٔلُ عَن ذَنۢبِهِۦٓ إِنسٌ وَلَا جَآنٌّ",
      "translation": "On that Day neither mankind nor jinn will be asked about their sins.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055039.mp3"
    },
    {
      "id": 4941,
      "verse_number": 40,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translation": "Which, then, of your Lord’s blessings do you both deny?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055040.mp3"
    },
    {
      "id": 4942,
      "verse_number": 41,
      "text_uthmani": "يُعْرَفُ ٱلْمُجْرِمُونَ بِسِيمَـٰهُمْ فَيُؤْخَذُ بِٱلنَّوَٰصِى وَٱلْأَقْدَامِ",
      "translation": "The guilty will be known by their mark and will be seized by their foreheads and their feet.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055041.mp3"
    },
    {
      "id": 4943,
      "verse_number": 42,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translation": "Which, then, of your Lord’s blessings do you both deny?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055042.mp3"
    },
    {
      "id": 4944,
      "verse_number": 43,
      "text_uthmani": "هَـٰذِهِۦ جَهَنَّمُ ٱلَّتِى يُكَذِّبُ بِهَا ٱلْمُجْرِمُونَ",
      "translation": "This is the Hell the guilty deny,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055043.mp3"
    },
    {
      "id": 4945,
      "verse_number": 44,
      "text_uthmani": "يَطُوفُونَ بَيْنَهَا وَبَيْنَ حَمِيمٍ ءَانٍ",
      "translation": "but they will go round between its flames and scalding water.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055044.mp3"
    },
    {
      "id": 4946,
      "verse_number": 45,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translation": "Which, then, of your Lord’s blessings do you both deny?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055045.mp3"
    },
    {
      "id": 4947,
      "verse_number": 46,
      "text_uthmani": "وَلِمَنْ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَانِ",
      "translation": "For those who fear [the time when they will] stand before their Lord there are two gardens.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055046.mp3"
    },
    {
      "id": 4948,
      "verse_number": 47,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translation": "Which, then, of your Lord’s blessings do you both deny?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/055047.mp3"
    },
    {
