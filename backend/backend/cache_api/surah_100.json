{
  "surah": {
    "id": 100,
    "name_arabic": "العاديات",
    "name_english": "The Courser",
    "revelation_place": "makkah",
    "verses_count": 11
  },
  "verses": [
    {
      "id": 6147,
      "verse_number": 1,
      "text_uthmani": " وَٱلْعَـٰدِيَـٰتِ ضَبْحًا",
      "translation": "By the charging steeds that pant",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/100001.mp3"
    },
    {
      "id": 6148,
      "verse_number": 2,
      "text_uthmani": "فَٱلْمُورِيَـٰتِ قَدْحًا",
      "translation": "and strike sparks with their hooves,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/100002.mp3"
    },
    {
      "id": 6149,
      "verse_number": 3,
      "text_uthmani": "فَٱلْمُغِيرَٰتِ صُبْحًا",
      "translation": "who make dawn raids,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/100003.mp3"
    },
    {
      "id": 6150,
      "verse_number": 4,
      "text_uthmani": "فَأَثَرْنَ بِهِۦ نَقْعًا",
      "translation": "raising a cloud of dust,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/100004.mp3"
    },
    {
      "id": 6151,
      "verse_number": 5,
      "text_uthmani": "فَوَسَطْنَ بِهِۦ جَمْعًا",
      "translation": "and plunging into the midst of the enemy,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/100005.mp3"
    },
    {
      "id": 6152,
      "verse_number": 6,
      "text_uthmani": "إِنَّ ٱلْإِنسَـٰنَ لِرَبِّهِۦ لَكَنُودٌ",
      "translation": "man is ungrateful to his Lord––",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/100006.mp3"
    },
    {
      "id": 6153,
      "verse_number": 7,
      "text_uthmani": "وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ",
      "translation": "and He is witness to this––",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/100007.mp3"
    },
    {
      "id": 6154,
      "verse_number": 8,
      "text_uthmani": "وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ",
      "translation": "he is truly excessive in his love of wealth.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/100008.mp3"
    },
    {
      "id": 6155,
      "verse_number": 9,
      "text_uthmani": "۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ",
      "translation": "Does he not know that when the contents of graves burst forth,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/100009.mp3"
    },
    {
      "id": 6156,
      "verse_number": 10,
      "text_uthmani": "وَحُصِّلَ مَا فِى ٱلصُّدُورِ",
      "translation": "when the secrets of hearts are uncovered, on that Day,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/100010.mp3"
    },
    {
      "id": 6157,
      "verse_number": 11,
      "text_uthmani": "إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍ لَّخَبِيرٌۢ",
      "translation": "their Lord will be fully aware of them all?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/100011.mp3"
    }
  ]
}