{
  "surah": {
    "id": 93,
    "name_arabic": "الضحى",
    "name_english": "The Morning Hours",
    "revelation_place": "makkah",
    "verses_count": 11
  },
  "verses": [
    {
      "id": 6080,
      "verse_number": 1,
      "text_uthmani": " وَٱلضُّحَىٰ",
      "translation": "By the morning brightness",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/093001.mp3"
    },
    {
      "id": 6081,
      "verse_number": 2,
      "text_uthmani": "وَٱلَّيْلِ إِذَا سَجَىٰ",
      "translation": "and by the night when it grows still,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/093002.mp3"
    },
    {
      "id": 6082,
      "verse_number": 3,
      "text_uthmani": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ",
      "translation": "your Lord has not forsaken you [Prophet], nor does He hate you,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/093003.mp3"
    },
    {
      "id": 6083,
      "verse_number": 4,
      "text_uthmani": "وَلَلْـَٔاخِرَةُ خَيْرٌ لَّكَ مِنَ ٱلْأُولَىٰ",
      "translation": "and the future will be better for you than the past;",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/093004.mp3"
    },
    {
      "id": 6084,
      "verse_number": 5,
      "text_uthmani": "وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ",
      "translation": "your Lord is sure to give you so much that you will be well satisfied.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/093005.mp3"
    },
    {
      "id": 6085,
      "verse_number": 6,
      "text_uthmani": "أَلَمْ يَجِدْكَ يَتِيمًا فَـَٔاوَىٰ",
      "translation": "Did He not find you an orphan and shelter you?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/093006.mp3"
    },
    {
      "id": 6086,
      "verse_number": 7,
      "text_uthmani": "وَوَجَدَكَ ضَآلًّا فَهَدَىٰ",
      "translation": "Did He not find you lost and guide you?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/093007.mp3"
    },
    {
      "id": 6087,
      "verse_number": 8,
      "text_uthmani": "وَوَجَدَكَ عَآئِلًا فَأَغْنَىٰ",
      "translation": "Did He not find you in need and make you self-sufficient?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/093008.mp3"
    },
    {
      "id": 6088,
      "verse_number": 9,
      "text_uthmani": "فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ",
      "translation": "So do not be harsh with the orphan",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/093009.mp3"
    },
    {
      "id": 6089,
      "verse_number": 10,
      "text_uthmani": "وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ",
      "translation": "and do not chide the one who asks for help;",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/093010.mp3"
    },
    {
      "id": 6090,
      "verse_number": 11,
      "text_uthmani": "وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ",
      "translation": "talk about the blessings of your Lord.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/093011.mp3"
    }
  ]
}