{
  "surah": {
    "id": 87,
    "name_arabic": "الأعلى",
    "name_english": "The Most High",
    "revelation_place": "makkah",
    "verses_count": 19
  },
  "verses": [
    {
      "id": 5949,
      "verse_number": 1,
      "text_uthmani": " سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى",
      "translation": "[Prophet], glorify the name of your Lord the Most High,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/087001.mp3"
    },
    {
      "id": 5950,
      "verse_number": 2,
      "text_uthmani": "ٱلَّذِى خَلَقَ فَسَوَّىٰ",
      "translation": "who created [all things] in due proportion;",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/087002.mp3"
    },
    {
      "id": 5951,
      "verse_number": 3,
      "text_uthmani": "وَٱلَّذِى قَدَّرَ فَهَدَىٰ",
      "translation": "who determined their destinies and guided them;",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/087003.mp3"
    },
    {
      "id": 5952,
      "verse_number": 4,
      "text_uthmani": "وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ",
      "translation": "who brought out the green pasture",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/087004.mp3"
    },
    {
      "id": 5953,
      "verse_number": 5,
      "text_uthmani": "فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ",
      "translation": "then made it dark debris.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/087005.mp3"
    },
    {
      "id": 5954,
      "verse_number": 6,
      "text_uthmani": "سَنُقْرِئُكَ فَلَا تَنسَىٰٓ",
      "translation": "[Prophet], We shall teach you [the Quran] and you will not forget––",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/087006.mp3"
    },
    {
      "id": 5955,
      "verse_number": 7,
      "text_uthmani": "إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ",
      "translation": "unless God wishes; He knows both what is open and what is hidden––",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/087007.mp3"
    },
    {
      "id": 5956,
      "verse_number": 8,
      "text_uthmani": "وَنُيَسِّرُكَ لِلْيُسْرَىٰ",
      "translation": "We shall show you the easy way.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/087008.mp3"
    },
    {
      "id": 5957,
      "verse_number": 9,
      "text_uthmani": "فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ",
      "translation": "So remind, if reminding will help.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/087009.mp3"
    },
    {
      "id": 5958,
      "verse_number": 10,
      "text_uthmani": "سَيَذَّكَّرُ مَن يَخْشَىٰ",
      "translation": "Those who stand in awe of God will heed the reminder,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/087010.mp3"
    },
    {
      "id": 5959,
      "verse_number": 11,
      "text_uthmani": "وَيَتَجَنَّبُهَا ٱلْأَشْقَى",
      "translation": "but it will be ignored by the most wicked,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/087011.mp3"
    },
    {
      "id": 5960,
      "verse_number": 12,
      "text_uthmani": "ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ",
      "translation": "who will enter the Great Fire,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/087012.mp3"
    },
    {
      "id": 5961,
      "verse_number": 13,
      "text_uthmani": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ",
      "translation": "where they will neither die nor live.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/087013.mp3"
    },
    {
      "id": 5962,
      "verse_number": 14,
      "text_uthmani": "قَدْ أَفْلَحَ مَن تَزَكَّىٰ",
      "translation": "Prosperous are those who purify themselves,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/087014.mp3"
    },
    {
      "id": 5963,
      "verse_number": 15,
      "text_uthmani": "وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ",
      "translation": "remember the name of their Lord, and pray.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/087015.mp3"
    },
    {
      "id": 5964,
      "verse_number": 16,
      "text_uthmani": "بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا",
      "translation": "Yet you [people] prefer the life of this world,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/087016.mp3"
    },
    {
      "id": 5965,
      "verse_number": 17,
      "text_uthmani": "وَٱلْـَٔاخِرَةُ خَيْرٌ وَأَبْقَىٰٓ",
      "translation": "even though the Hereafter is better and more lasting.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/087017.mp3"
    },
    {
      "id": 5966,
      "verse_number": 18,
      "text_uthmani": "إِنَّ هَـٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ",
      "translation": "All this is in the earlier scriptures,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/087018.mp3"
    },
    {
      "id": 5967,
      "verse_number": 19,
      "text_uthmani": "صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ",
      "translation": "the scriptures of Abraham and Moses.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/087019.mp3"
    }
  ]
}