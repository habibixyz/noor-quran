{
  "surah": {
    "id": 88,
    "name_arabic": "الغاشية",
    "name_english": "The Overwhelming",
    "revelation_place": "makkah",
    "verses_count": 26
  },
  "verses": [
    {
      "id": 5968,
      "verse_number": 1,
      "text_uthmani": " هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَـٰشِيَةِ",
      "translation": "Have you heard tell [Prophet] about the Overwhelming Event?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/088001.mp3"
    },
    {
      "id": 5969,
      "verse_number": 2,
      "text_uthmani": "وُجُوهٌ يَوْمَئِذٍ خَـٰشِعَةٌ",
      "translation": "On that Day, there will be downcast faces,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/088002.mp3"
    },
    {
      "id": 5970,
      "verse_number": 3,
      "text_uthmani": "عَامِلَةٌ نَّاصِبَةٌ",
      "translation": "toiling and weary,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/088003.mp3"
    },
    {
      "id": 5971,
      "verse_number": 4,
      "text_uthmani": "تَصْلَىٰ نَارًا حَامِيَةً",
      "translation": "as they enter the blazing Fire",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/088004.mp3"
    },
    {
      "id": 5972,
      "verse_number": 5,
      "text_uthmani": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ",
      "translation": "and are forced to drink from a boiling spring,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/088005.mp3"
    },
    {
      "id": 5973,
      "verse_number": 6,
      "text_uthmani": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ",
      "translation": "with no food for them except bitter dry thorns",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/088006.mp3"
    },
    {
      "id": 5974,
      "verse_number": 7,
      "text_uthmani": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ",
      "translation": "that neither nourish nor satisfy hunger.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/088007.mp3"
    },
    {
      "id": 5975,
      "verse_number": 8,
      "text_uthmani": "وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ",
      "translation": "On that Day there will also be faces radiant with bliss,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/088008.mp3"
    },
    {
      "id": 5976,
      "verse_number": 9,
      "text_uthmani": "لِّسَعْيِهَا رَاضِيَةٌ",
      "translation": "well pleased with their labour,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/088009.mp3"
    },
    {
      "id": 5977,
      "verse_number": 10,
      "text_uthmani": "فِى جَنَّةٍ عَالِيَةٍ",
      "translation": "in a lofty garden,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/088010.mp3"
    },
    {
      "id": 5978,
      "verse_number": 11,
      "text_uthmani": "لَّا تَسْمَعُ فِيهَا لَـٰغِيَةً",
      "translation": "where they will hear no idle talk,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/088011.mp3"
    },
    {
      "id": 5979,
      "verse_number": 12,
      "text_uthmani": "فِيهَا عَيْنٌ جَارِيَةٌ",
      "translation": "with a flowing spring,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/088012.mp3"
    },
    {
      "id": 5980,
      "verse_number": 13,
      "text_uthmani": "فِيهَا سُرُرٌ مَّرْفُوعَةٌ",
      "translation": "raised couches,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/088013.mp3"
    },
    {
      "id": 5981,
      "verse_number": 14,
      "text_uthmani": "وَأَكْوَابٌ مَّوْضُوعَةٌ",
      "translation": "goblets placed before them,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/088014.mp3"
    },
    {
      "id": 5982,
      "verse_number": 15,
      "text_uthmani": "وَنَمَارِقُ مَصْفُوفَةٌ",
      "translation": "cushions set in rows,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/088015.mp3"
    },
    {
      "id": 5983,
      "verse_number": 16,
      "text_uthmani": "وَزَرَابِىُّ مَبْثُوثَةٌ",
      "translation": "and carpets spread.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/088016.mp3"
    },
    {
      "id": 5984,
      "verse_number": 17,
      "text_uthmani": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ",
      "translation": "Do the disbelievers not see how rain clouds are formed <sup foot_note=77646>1</sup>",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/088017.mp3"
    },
    {
      "id": 5985,
      "verse_number": 18,
      "text_uthmani": "وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ",
      "translation": "how the heavens are lifted,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/088018.mp3"
    },
    {
      "id": 5986,
      "verse_number": 19,
      "text_uthmani": "وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ",
      "translation": "how the mountains are raised high,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/088019.mp3"
    },
    {
      "id": 5987,
      "verse_number": 20,
      "text_uthmani": "وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ",
      "translation": "how the earth is spread out?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/088020.mp3"
    },
    {
      "id": 5988,
      "verse_number": 21,
      "text_uthmani": "فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌ",
      "translation": "So [Prophet] warn them: your only task is to give warning,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/088021.mp3"
    },
    {
      "id": 5989,
      "verse_number": 22,
      "text_uthmani": "لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ",
      "translation": "you are not there to control them.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/088022.mp3"
    },
    {
      "id": 5990,
      "verse_number": 23,
      "text_uthmani": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ",
      "translation": "As for those who turn away and disbelieve,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/088023.mp3"
    },
    {
      "id": 5991,
      "verse_number": 24,
      "text_uthmani": "فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ",
      "translation": "God will inflict the greatest torment upon them.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/088024.mp3"
    },
    {
      "id": 5992,
      "verse_number": 25,
      "text_uthmani": "إِنَّ إِلَيْنَآ إِيَابَهُمْ",
      "translation": "It is to Us they will return,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/088025.mp3"
    },
    {
      "id": 5993,
      "verse_number": 26,
      "text_uthmani": "ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم",
      "translation": "and then it is for Us to call them to account.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/088026.mp3"
    }
  ]
}