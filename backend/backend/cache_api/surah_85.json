{
  "surah": {
    "id": 85,
    "name_arabic": "البروج",
    "name_english": "The Mansions of the Stars",
    "revelation_place": "makkah",
    "verses_count": 22
  },
  "verses": [
    {
      "id": 5910,
      "verse_number": 1,
      "text_uthmani": " وَٱلسَّمَآءِ ذَاتِ ٱلْبُرُوجِ",
      "translation": "By the sky with its towering constellations,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/085001.mp3"
    },
    {
      "id": 5911,
      "verse_number": 2,
      "text_uthmani": "وَٱلْيَوْمِ ٱلْمَوْعُودِ",
      "translation": "by the promised Day,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/085002.mp3"
    },
    {
      "id": 5912,
      "verse_number": 3,
      "text_uthmani": "وَشَاهِدٍ وَمَشْهُودٍ",
      "translation": "by the Witness and that which is witnessed,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/085003.mp3"
    },
    {
      "id": 5913,
      "verse_number": 4,
      "text_uthmani": "قُتِلَ أَصْحَـٰبُ ٱلْأُخْدُودِ",
      "translation": "damned were the makers of the trench,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/085004.mp3"
    },
    {
      "id": 5914,
      "verse_number": 5,
      "text_uthmani": "ٱلنَّارِ ذَاتِ ٱلْوَقُودِ",
      "translation": "the makers of the fuel-stoked fire!",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/085005.mp3"
    },
    {
      "id": 5915,
      "verse_number": 6,
      "text_uthmani": "إِذْ هُمْ عَلَيْهَا قُعُودٌ",
      "translation": "They sat down",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/085006.mp3"
    },
    {
      "id": 5916,
      "verse_number": 7,
      "text_uthmani": "وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِٱلْمُؤْمِنِينَ شُهُودٌ",
      "translation": "to watch what they were doing to the believers.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/085007.mp3"
    },
    {
      "id": 5917,
      "verse_number": 8,
      "text_uthmani": "وَمَا نَقَمُوا۟ مِنْهُمْ إِلَّآ أَن يُؤْمِنُوا۟ بِٱللَّهِ ٱلْعَزِيزِ ٱلْحَمِيدِ",
      "translation": "Their only grievance against them was their faith in God, the Mighty, the Praiseworthy,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/085008.mp3"
    },
    {
      "id": 5918,
      "verse_number": 9,
      "text_uthmani": "ٱلَّذِى لَهُۥ مُلْكُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ شَهِيدٌ",
      "translation": "to whom all control over the heavens and earth belongs: God is witness over all things.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/085009.mp3"
    },
    {
      "id": 5919,
      "verse_number": 10,
      "text_uthmani": "إِنَّ ٱلَّذِينَ فَتَنُوا۟ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَـٰتِ ثُمَّ لَمْ يَتُوبُوا۟ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ ٱلْحَرِيقِ",
      "translation": "For those who persecute believing men and women, and do not repent afterwards, there will be the torment of Hell and burning.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/085010.mp3"
    },
    {
      "id": 5920,
      "verse_number": 11,
      "text_uthmani": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَهُمْ جَنَّـٰتٌ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَـٰرُ ۚ ذَٰلِكَ ٱلْفَوْزُ ٱلْكَبِيرُ",
      "translation": "But for those who believe and do good deeds there will be Gardens graced with flowing streams: that is the great triumph.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/085011.mp3"
    },
    {
      "id": 5921,
      "verse_number": 12,
      "text_uthmani": "إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌ",
      "translation": "[Prophet], your Lord’s punishment is truly stern––",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/085012.mp3"
    },
    {
      "id": 5922,
      "verse_number": 13,
      "text_uthmani": "إِنَّهُۥ هُوَ يُبْدِئُ وَيُعِيدُ",
      "translation": "it is He who brings people to life, and will restore them to life again––",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/085013.mp3"
    },
    {
      "id": 5923,
      "verse_number": 14,
      "text_uthmani": "وَهُوَ ٱلْغَفُورُ ٱلْوَدُودُ",
      "translation": "and He is the Most Forgiving, the Most Loving.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/085014.mp3"
    },
    {
      "id": 5924,
      "verse_number": 15,
      "text_uthmani": "ذُو ٱلْعَرْشِ ٱلْمَجِيدُ",
      "translation": "The Glorious Lord of the Throne,",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/085015.mp3"
    },
    {
      "id": 5925,
      "verse_number": 16,
      "text_uthmani": "فَعَّالٌ لِّمَا يُرِيدُ",
      "translation": "He does whatever He will.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/085016.mp3"
    },
    {
      "id": 5926,
      "verse_number": 17,
      "text_uthmani": "هَلْ أَتَىٰكَ حَدِيثُ ٱلْجُنُودِ",
      "translation": "Have you [not] heard the stories of the forces",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/085017.mp3"
    },
    {
      "id": 5927,
      "verse_number": 18,
      "text_uthmani": "فِرْعَوْنَ وَثَمُودَ",
      "translation": "of Pharaoh and Thamud?",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/085018.mp3"
    },
    {
      "id": 5928,
      "verse_number": 19,
      "text_uthmani": "بَلِ ٱلَّذِينَ كَفَرُوا۟ فِى تَكْذِيبٍ",
      "translation": "Yet still the disbelievers persist in denial.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/085019.mp3"
    },
    {
      "id": 5929,
      "verse_number": 20,
      "text_uthmani": "وَٱللَّهُ مِن وَرَآئِهِم مُّحِيطٌۢ",
      "translation": "God surrounds them all.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/085020.mp3"
    },
    {
      "id": 5930,
      "verse_number": 21,
      "text_uthmani": "بَلْ هُوَ قُرْءَانٌ مَّجِيدٌ",
      "translation": "This is truly a glorious Quran",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/085021.mp3"
    },
    {
      "id": 5931,
      "verse_number": 22,
      "text_uthmani": "فِى لَوْحٍ مَّحْفُوظٍۭ",
      "translation": "[written] on a preserved Tablet.",
      "audio_url": "https://verses.quran.com/Alafasy/mp3/085022.mp3"
    }
  ]
}